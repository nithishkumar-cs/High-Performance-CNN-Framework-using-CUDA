# Local datasets, checkpoints, and measurements are never versioned.
/data/
/runs/
*.pt
*.weights
*.onnx
*.engine

# Native build products and local editor settings.
/build/
/build-cudnn/
/cmake-build-*/
*.exe
*.obj
*.o
*.lib
*.exp
.vscode/

# Remnants of earlier experiments may exist locally after the rollback.
__pycache__/
*.pyc
.agent-work/

# Local cuDNN install (pip-installed nvidia-cudnn-cu12 wheel contents, staged
# for CMake's DETECTOR_CUDNN option) - third-party binaries/headers, never versioned.
/third_party/
