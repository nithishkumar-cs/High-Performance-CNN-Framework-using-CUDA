FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git make g++ python3 && \
    rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/pjreddie/darknet.git /opt/darknet && \
    git -C /opt/darknet checkout f6afaabcdf85f77e7aff2ec55c020c0e297c77f9 && \
    make -C /opt/darknet GPU=1 CUDNN=0 OPENCV=0 \
      NVCC=/usr/local/cuda/bin/nvcc \
      ARCH='-gencode arch=compute_86,code=sm_86' -j4

WORKDIR /work
